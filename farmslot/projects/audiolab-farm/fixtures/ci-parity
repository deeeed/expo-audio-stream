#!/usr/bin/env bash
set -euo pipefail
FARM_ROOT="${FARMSLOT_ROOT:?Set FARMSLOT_ROOT to the farm installation root}"
case "$FARM_ROOT" in
  '~/'*) FARM_ROOT="$HOME/${FARM_ROOT#\~/}" ;;
esac
source "$FARM_ROOT/projects/audiolab-farm/scripts/configured-paths.sh"
audiolab_check_paths
export PATH="$AUDIOLAB_NODE_BIN:$PATH"
export AUDIOLAB_NPM_TOKEN="${AUDIOLAB_NPM_TOKEN:-}"
exec node "$FARM_ROOT/projects/audiolab-farm/scripts/ci-local.mjs"
