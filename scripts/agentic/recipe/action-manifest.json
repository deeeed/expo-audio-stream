{
  "$schema": "https://farmslot.io/schemas/action-manifest-v1.schema.json",
  "actions": {
    "command": {
      "description": "Run a project-local command during setup, diagnostics, or headless proof. Prefer UI actions only when the recipe must prove visible interaction.",
      "schema": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string"
          },
          "timeout_ms": {
            "type": "integer"
          },
          "cwd": {
            "type": "string"
          },
          "allow_failure": {
            "type": "boolean"
          }
        },
        "required": [
          "cmd"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "command",
          "intent": "Prepare the project state needed for this proof.",
          "cmd": "true",
          "next": "done"
        }
      ]
    },
    "assert_output": {
      "description": "Assert stdout or stderr from a previous command node.",
      "schema": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "stream": {
            "type": "string"
          },
          "contains": {
            "type": "string"
          },
          "match": {
            "type": "string"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "assert_output",
          "intent": "Confirm the recorded output satisfies the requested condition.",
          "source": "command",
          "contains": "ready",
          "next": "done"
        }
      ]
    },
    "wait": {
      "description": "Pause briefly for asynchronous setup work. Keep waits short and prefer deterministic assertions.",
      "schema": {
        "type": "object",
        "properties": {
          "duration_ms": {
            "type": "integer"
          }
        },
        "required": [
          "duration_ms"
        ],
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "wait",
          "intent": "Allow the requested asynchronous state to settle.",
          "duration_ms": 1,
          "next": "done"
        }
      ]
    },
    "ui.press": {
      "description": "Press a native accessibility target on the assigned simulator or device.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "boolean"
          }
        }
      },
      "examples": [
        {
          "action": "ui.press",
          "test_id": "start-recording-button",
          "intent": "Start recording audio.",
          "next": "done"
        }
      ]
    },
    "ui.set_input": {
      "description": "Set text on a native input. Android recipes must provide test_id so the replacement can be verified from the native snapshot. Values remain part of retained recipe artifacts, so recipes must not contain secrets.",
      "schema": {
        "type": "object",
        "properties": {
          "test_id": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "test_id"
        ]
      },
      "examples": [
        {
          "action": "ui.set_input",
          "intent": "Provide the requested value in the visible form.",
          "test_id": "example-input",
          "value": "example",
          "next": "done"
        }
      ]
    },
    "ui.scroll": {
      "description": "Scroll the assigned native simulator or device and wait for stability.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "test_id",
          "offset_y"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "offset_y": {
            "type": "number"
          }
        }
      },
      "examples": [
        {
          "action": "ui.scroll",
          "intent": "Reveal the available speech models.",
          "test_id": "models-list",
          "offset_y": 300,
          "next": "done"
        }
      ]
    },
    "ui.screenshot": {
      "description": "Capture the assigned native simulator or device into the artifact package.",
      "schema": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "claims": {
            "type": "object",
            "properties": {
              "must_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "must_not_show": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
          "covers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          },
          "baseline": {
            "type": "string"
          },
          "max_diff_pixels": {
            "type": "integer",
            "minimum": 0
          },
          "max_diff_ratio": {
            "type": "number",
            "minimum": 0
          },
          "pixel_threshold": {
            "type": "number",
            "minimum": 0
          },
          "update_baseline": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        {
          "action": "ui.screenshot",
          "intent": "Preserve the visible application state as review evidence.",
          "label": "example-state",
          "next": "done"
        }
      ]
    },
    "end": {
      "description": "Terminate the recipe graph with pass, fail, or unknown.",
      "examples": [
        {
          "action": "end",
          "status": "pass"
        }
      ]
    },
    "ui.navigate": {
      "description": "Open an app route.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "execution_capabilities": [],
      "examples": [
        {
          "action": "ui.navigate",
          "intent": "Open an app route.",
          "path": "/(tabs)/record",
          "next": "done"
        }
      ]
    },
    "app.status": {
      "description": "Read the selected app runtime.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      },
      "execution_capabilities": [],
      "examples": [
        {
          "action": "app.status",
          "intent": "Read the selected app runtime.",
          "next": "done"
        }
      ]
    },
    "app.hud": {
      "description": "Show the current proof intent.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          },
          "intent": {
            "type": "string"
          },
          "currentStep": {
            "type": "integer",
            "minimum": 1
          },
          "totalSteps": {
            "type": "integer",
            "minimum": 1
          },
          "detail": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "display": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": []
      },
      "execution_capabilities": [],
      "examples": [
        {
          "action": "app.hud",
          "intent": "Show the current proof intent.",
          "next": "done"
        }
      ]
    },
    "audiolab.query": {
      "description": "Read or exercise an app bridge probe and verify its result.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ref": {
            "type": "string"
          },
          "expression": {
            "type": "string"
          },
          "async": {
            "type": "boolean"
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          },
          "fail_when": {
            "type": "object",
            "additionalProperties": true
          },
          "poll": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "poll_ms": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": []
      },
      "execution_capabilities": [
        "arbitrary-code",
        "app-mutation"
      ],
      "examples": [
        {
          "action": "audiolab.query",
          "intent": "Read or exercise an app bridge probe and verify its result.",
          "ref": "recording-state",
          "next": "done"
        }
      ]
    },
    "audiolab.choose": {
      "description": "Choose the next audio validation path from observed state.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rules": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          }
        },
        "required": [
          "rules"
        ]
      },
      "execution_capabilities": [],
      "examples": [
        {
          "action": "audiolab.choose",
          "intent": "Choose the next audio validation path from observed state.",
          "rules": [
            {
              "field": "env.platform",
              "operator": "eq",
              "value": "web"
            }
          ],
          "cases": {
            "case-0": "done"
          },
          "default": "done"
        }
      ],
      "result_cases": [
        "case-0",
        "case-1",
        "case-2"
      ]
    },
    "audiolab.logs": {
      "description": "Read the selected app Metro log and check forbidden messages.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "watch_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "must_not_appear": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": []
      },
      "execution_capabilities": [
        "host-read-export"
      ],
      "examples": [
        {
          "action": "audiolab.logs",
          "intent": "Read the selected app Metro log and check forbidden messages.",
          "watch_for": [
            "AudioStreamDecoder"
          ],
          "next": "done"
        }
      ]
    },
    "audiolab.native_preview": {
      "description": "Extract a preview from the bundled audio sample.",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeout_ms": {
            "type": "integer",
            "minimum": 1
          },
          "assert": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": []
      },
      "execution_capabilities": [
        "app-mutation"
      ],
      "examples": [
        {
          "action": "audiolab.native_preview",
          "intent": "Extract a preview from the bundled audio sample.",
          "timeout_ms": 30000,
          "assert": {
            "field": "status",
            "operator": "eq",
            "value": "success"
          },
          "next": "done"
        }
      ],
      "adapters": [
        "ios",
        "android"
      ]
    }
  }
}
