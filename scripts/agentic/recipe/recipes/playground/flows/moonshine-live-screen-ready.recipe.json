{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Playground Moonshine + Sherpa live screen smoke validation",
  "description": "Playground Moonshine + Sherpa live screen smoke validation",
  "workflow": {
    "entry": "prepare-ready-0",
    "nodes": {
      "nav-moonshine-live": {
        "action": "ui.navigate",
        "intent": "Nav moonshine live.",
        "next": "wait-live-route",
        "path": "/moonshine-live"
      },
      "wait-live-route": {
        "action": "audiolab.query",
        "intent": "Wait live route.",
        "next": "wait-prepare-button",
        "ref": "route",
        "assert": {
          "operator": "eq",
          "field": "pathname",
          "value": "/moonshine-live"
        },
        "poll": true
      },
      "wait-prepare-button": {
        "action": "audiolab.query",
        "intent": "Wait prepare button.",
        "next": "wait-start-button",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"moonshine-live-prepare-models\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "wait-start-button": {
        "action": "audiolab.query",
        "intent": "Wait start button.",
        "next": "wait-metrics",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"moonshine-live-start\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "wait-metrics": {
        "action": "audiolab.query",
        "intent": "Wait metrics.",
        "next": "done",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"moonshine-sherpa-metrics\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "prepare-ready-0": {
        "action": "audiolab.query",
        "ref": "playground.agentic_ready",
        "assert": {
          "operator": "not_null",
          "field": "pathname"
        },
        "intent": "The playground app is running with the agentic bridge installed.",
        "next": "nav-moonshine-live"
      }
    }
  }
}
