{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Playground ASR benchmark screen smoke validation",
  "description": "Playground ASR benchmark screen smoke validation",
  "workflow": {
    "entry": "prepare-ready-0",
    "nodes": {
      "nav-benchmark": {
        "action": "ui.navigate",
        "intent": "Nav benchmark.",
        "next": "wait-benchmark-route",
        "path": "/asr-benchmark"
      },
      "wait-benchmark-route": {
        "action": "audiolab.query",
        "intent": "Wait benchmark route.",
        "next": "wait-model-button",
        "ref": "route",
        "assert": {
          "operator": "eq",
          "field": "pathname",
          "value": "/asr-benchmark"
        },
        "poll": true
      },
      "wait-model-button": {
        "action": "audiolab.query",
        "intent": "Wait model button.",
        "next": "wait-run-button",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"asr-benchmark-model-moonshine-small-streaming-en\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "wait-run-button": {
        "action": "audiolab.query",
        "intent": "Wait run button.",
        "next": "done",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"asr-benchmark-run-sample\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "prepare-ready-0": {
        "action": "audiolab.query",
        "ref": "playground.agentic_ready",
        "assert": {
          "operator": "not_null",
          "field": "pathname"
        },
        "intent": "The playground app is running with the agentic bridge installed.",
        "next": "nav-benchmark"
      }
    }
  }
}
