{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Playground record screen smoke validation",
  "description": "Playground record screen smoke validation",
  "workflow": {
    "entry": "prepare-ready-0",
    "nodes": {
      "nav-record": {
        "action": "ui.navigate",
        "intent": "Nav record.",
        "next": "wait-record-route",
        "path": "/(tabs)/record"
      },
      "wait-record-route": {
        "action": "audiolab.query",
        "intent": "Wait record route.",
        "next": "wait-record-wrapper",
        "ref": "route",
        "assert": {
          "operator": "eq",
          "field": "pathname",
          "value": "/record"
        },
        "poll": true
      },
      "wait-record-wrapper": {
        "action": "audiolab.query",
        "intent": "Wait record wrapper.",
        "next": "wait-filename-input",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"record-screen-wrapper\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "wait-filename-input": {
        "action": "audiolab.query",
        "intent": "Wait filename input.",
        "next": "assert-recorder-idle",
        "expression": "JSON.stringify({visible: !!globalThis.__AGENTIC__?.findFiberByTestId?.(\"filename-input\")})",
        "assert": {
          "operator": "eq",
          "field": "visible",
          "value": true
        },
        "poll": true
      },
      "assert-recorder-idle": {
        "action": "audiolab.query",
        "intent": "Assert recorder idle.",
        "next": "done",
        "assert": {
          "operator": "eq",
          "field": "isRecording",
          "value": false
        },
        "ref": "recording-state"
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "prepare-ready-0": {
        "action": "audiolab.query",
        "ref": "playground.agentic_ready",
        "assert": {
          "operator": "not_null",
          "field": "pathname"
        },
        "intent": "The playground app is running with the agentic bridge installed.",
        "next": "nav-record"
      }
    }
  }
}
