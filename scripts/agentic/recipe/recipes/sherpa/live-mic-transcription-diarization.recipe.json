{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Sherpa Voice live microphone transcription + speaker-turn keep-up validation",
  "description": "Records short live microphone audio with streamFormat:'float32' and feeds chunks into streaming ASR, VAD, and Speaker ID. This validates the real mic path and processing backpressure on device. It does not require speech in the room; transcript/speaker events are opportunistic. Fresh Android installs need microphone permission; grant RECORD_AUDIO or accept the runtime permission prompt before running.",
  "workflow": {
    "entry": "prepare-ready-0",
    "nodes": {
      "nav-diarization": {
        "action": "ui.navigate",
        "intent": "Nav diarization.",
        "next": "run-live-mic",
        "path": "/features/diarization"
      },
      "run-live-mic": {
        "action": "audiolab.query",
        "intent": "Fire 10s mic recording through ASR + VAD + Speaker ID.",
        "next": "wait-live-mic-result",
        "assert": {
          "operator": "eq",
          "field": "status",
          "value": "pending"
        },
        "expression": "JSON.stringify((function(){var A=globalThis.__AGENTIC__;if(!A||!A.testLiveMicTranscriptionDiarization||!A.getLastResult){return {status:'error',error:'agentic bridge missing testLiveMicTranscriptionDiarization/getLastResult'};}return A.testLiveMicTranscriptionDiarization({durationMs:10000,chunkDurationMs:100,asrModelId:'streaming-zipformer-en-20m-mobile',vadModelId:'silero-vad-v5',speakerIdModelId:'speaker-id-en-voxceleb'});})())"
      },
      "wait-live-mic-result": {
        "action": "audiolab.query",
        "intent": "Poll fire-and-store mic result.",
        "next": "assert-chunks",
        "assert": {
          "operator": "eq",
          "field": "status",
          "value": "success"
        },
        "fail_when": {
          "operator": "eq",
          "field": "status",
          "value": "error"
        },
        "timeout_ms": 120000,
        "poll_ms": 1000,
        "expression": "JSON.stringify(globalThis.__AGENTIC__?.getLastResult?.() || {})",
        "poll": true
      },
      "assert-chunks": {
        "action": "audiolab.query",
        "intent": "Assert mic chunks were received and processed.",
        "next": "assert-keeps-up",
        "assert": {
          "operator": "gt",
          "field": "result.stats.chunks",
          "value": 0
        },
        "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())"
      },
      "assert-keeps-up": {
        "action": "audiolab.query",
        "intent": "Assert mic processing kept up without backpressure.",
        "next": "done",
        "assert": {
          "operator": "eq",
          "field": "result.keepsUpWithLiveAudio",
          "value": true
        },
        "expression": "JSON.stringify(globalThis.__AGENTIC__.getLastResult())"
      },
      "done": {
        "action": "end",
        "status": "pass"
      },
      "prepare-ready-0": {
        "action": "audiolab.query",
        "ref": "sherpa.agentic_ready",
        "assert": {
          "operator": "not_null",
          "field": "pathname"
        },
        "intent": "The sherpa-voice app is running with the agentic bridge installed.",
        "next": "nav-diarization"
      }
    }
  }
}
